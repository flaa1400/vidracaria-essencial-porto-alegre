---
const rawHtml = await Astro.slots.render('default');
const localizedHtml = rawHtml
  .replace(/em Porto Alegre/g, 'em Canoas - RS')
  .replace(/Porto Alegre/g, 'Canoas - RS')
  .replace(/na capital/g, 'em Canoas')
  .replace(/da capital/g, 'de Canoas')
  .replace(/à capital/g, 'a Canoas');
---

<div class="prose prose-lg prose-slate max-w-none prose-headings:font-black prose-headings:uppercase prose-headings:tracking-tighter prose-p:leading-relaxed prose-p:mb-8 prose-strong:text-secondary" set:html={localizedHtml} />
