---
const html = await Astro.slots.render('default');
const { bairroName } = Astro.props;
const localizedHtml = html.replace(/Porto Alegre/g, `${bairroName} em Porto Alegre`);
---
<div class="prose prose-lg prose-slate max-w-none prose-p:leading-loose prose-p:mb-10 text-gray-600" set:html={localizedHtml} />

