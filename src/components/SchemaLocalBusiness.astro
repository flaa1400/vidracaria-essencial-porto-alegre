---
import { SITE_CONFIG } from '../data/config';

interface Props {
  phone?: string;
  city?: string;
  areaServed?: string;
  latitude?: number;
  longitude?: number;
}

const { 
  phone = SITE_CONFIG.contact.phone,
  city = SITE_CONFIG.address.city,
  areaServed = 'Porto Alegre, RS',
  latitude = (city === 'Canoas' ? -29.9179 : -30.0346),
  longitude = (city === 'Canoas' ? -51.1795 : -51.2177)
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": city === 'Canoas' ? `${SITE_CONFIG.name} - Vidraçaria em Canoas` : SITE_CONFIG.name,
  "image": `${SITE_CONFIG.domain}/og-image.jpg`,
  "@id": `${SITE_CONFIG.domain}/#localbusiness`,
  "url": SITE_CONFIG.domain,
  "telephone": phone,
  "areaServed": areaServed,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE_CONFIG.address.street,
    "addressLocality": city,
    "addressRegion": SITE_CONFIG.address.state,
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": latitude,
    "longitude": longitude
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:30"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": "Saturday",
      "opens": "08:00",
      "closes": "13:00"
    }
  ],
  "sameAs": [
    `https://instagram.com/${SITE_CONFIG.social.instagram}`,
    `https://facebook.com/${SITE_CONFIG.social.facebook}`
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

