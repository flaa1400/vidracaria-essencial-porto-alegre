---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/config';
---

<Layout title={`Contato | ${SITE_CONFIG.name}`}>
	<section class="py-24 md:py-32 bg-white">
		<div class="container mx-auto px-6 md:px-12">
			<h1 class="text-4xl md:text-6xl font-black mb-20 tracking-tighter uppercase text-gray-900 leading-none">Inicie seu <br/> Projeto de Elite</h1>
			
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-24">
				<!-- Form Section -->
				<div>
					<p class="text-xl text-gray-600 mb-16 leading-relaxed font-medium italic border-l-8 border-primary pl-8">Preencha os dados abaixo e nosso técnico entrará em contato em até 24h úteis.</p>
					
					<form action="https://api.web3forms.com/submit" method="POST" class="space-y-10 bg-gray-50 p-12 md:p-16 shadow-2xl border-t-[12px] border-secondary relative overflow-hidden group">
						<input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE">
						<div class="absolute top-0 right-0 w-24 h-24 bg-primary translate-x-12 -translate-y-12 rotate-45 opacity-20"></div>
						
						<div class="grid grid-cols-1 gap-10 relative z-10">
							<div>
								<label class="block text-[10px] font-black uppercase tracking-[0.3em] mb-4 text-gray-400">Nome Completo</label>
								<input type="text" name="name" required class="w-full p-8 bg-white border-2 border-gray-100 focus:border-secondary outline-none transition-all font-bold placeholder:text-gray-200" placeholder="Ex: Marcelo Oliveira" />
							</div>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-10">
								<div>
									<label class="block text-[10px] font-black uppercase tracking-[0.3em] mb-4 text-gray-400">WhatsApp</label>
									<input type="tel" name="phone" required class="w-full p-8 bg-white border-2 border-gray-100 focus:border-secondary outline-none transition-all font-bold placeholder:text-gray-200" placeholder={SITE_CONFIG.contact.phone} />
								</div>
								<div>
									<label class="block text-[10px] font-black uppercase tracking-[0.3em] mb-4 text-gray-400">Interesse</label>
									<select name="subject" class="w-full p-8 bg-white border-2 border-gray-100 focus:border-secondary outline-none transition-all font-black uppercase text-xs appearance-none cursor-pointer">
										<option>Box para Banheiro</option>
										<option>Espelhos Premium</option>
										<option>Fechamento Sacada</option>
										<option>Outros Projetos</option>
									</select>
								</div>
							</div>
							<div>
								<label class="block text-[10px] font-black uppercase tracking-[0.3em] mb-4 text-gray-400">Mensagem</label>
								<textarea name="message" required class="w-full p-8 bg-white border-2 border-gray-100 focus:border-secondary outline-none transition-all font-bold min-h-[120px] placeholder:text-gray-200" placeholder="Conte brevemente sua necessidade..."></textarea>
							</div>
						</div>
						
						<button type="submit" class="w-full bg-secondary text-white font-black p-10 uppercase tracking-[0.2em] text-xs hover:bg-accent hover:scale-[1.02] active:scale-95 transition-all shadow-2xl shadow-secondary/30 relative z-10">
							Solicitar Orçamento Grátis
						</button>
					</form>
					
					<div class="mt-8 text-center">
						<p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">Preferência por e-mail?</p>
						<a href={`mailto:${SITE_CONFIG.contact.email}`} class="text-secondary font-black hover:text-accent transition-colors border-b-2 border-secondary/20 hover:border-accent italic">
							{SITE_CONFIG.contact.email}
						</a>
					</div>
				</div>

				<!-- NAP & Info -->
				<div class="space-y-20">
					<div>
						<span class="text-[10px] font-black uppercase tracking-[0.5em] text-primary mb-8 block">Dados Oficiais</span>
						<div class="space-y-16">
							<div class="group">
								<h3 class="text-3xl font-black uppercase mb-4 text-gray-900 leading-tight group-hover:text-secondary transition-colors">{SITE_CONFIG.name}</h3>
								<p class="text-lg text-gray-500 font-medium">Excelência e Precisão em Vidros</p>
							</div>
							
							<div class="flex items-start gap-8 group">
								<div class="text-5xl group-hover:scale-110 transition-transform">📍</div>
								<div>
									<h4 class="font-black uppercase text-[10px] tracking-widest mb-3 text-gray-400">Endereço</h4>
									<p class="text-gray-900 font-bold text-lg leading-tight">{SITE_CONFIG.address.street}</p>
									<p class="text-gray-500 text-sm mt-1 uppercase font-bold tracking-tighter">{SITE_CONFIG.address.neighborhood} - {SITE_CONFIG.address.city}/{SITE_CONFIG.address.state}</p>
								</div>
							</div>

							<div class="flex items-start gap-8 group">
								<div class="text-5xl group-hover:scale-110 transition-transform">📞</div>
								<div>
									<h4 class="font-black uppercase text-[10px] tracking-widest mb-3 text-gray-400">Atendimento Direto</h4>
									<span class="text-4xl font-black text-secondary leading-none">{SITE_CONFIG.contact.phone}</span>
								</div>
							</div>

							<div class="flex items-start gap-8 group">
								<div class="text-5xl group-hover:scale-110 transition-transform">✉️</div>
								<div>
									<h4 class="font-black uppercase text-[10px] tracking-widest mb-3 text-gray-400">E-mail</h4>
									<a href={`mailto:${SITE_CONFIG.contact.email}`} class="text-xl font-bold text-gray-900 hover:text-secondary transition-colors lowercase">{SITE_CONFIG.contact.email}</a>
								</div>
							</div>
						</div>
					</div>

					<div class="bg-accent p-12 md:p-16 shadow-2xl relative overflow-hidden group">
						<div class="absolute bottom-0 left-0 w-full h-2 bg-primary group-hover:h-full transition-all duration-700 opacity-10"></div>
						<h3 class="text-xl font-black uppercase mb-10 text-primary relative z-10 tracking-widest">Horário de Atendimento</h3>
						<div class="space-y-6 text-white font-bold relative z-10 text-sm">
							<div class="flex justify-between border-b border-white/10 pb-4">
								<span class="uppercase tracking-widest">Segunda - Sexta</span>
								<span class="text-primary tracking-tighter font-black text-lg">08:00 - 18:30</span>
							</div>
							<div class="flex justify-between text-white font-bold pb-4">
								<span class="uppercase tracking-widest">Sábado</span>
								<span class="text-primary tracking-tighter font-black text-lg">08:00 - 13:00</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
