	<!-- FAQ Interactive Script -->
	<script>
		const faqItems = document.querySelectorAll('.faq-item');
		faqItems.forEach(item => {
			const trigger = item.querySelector('.faq-trigger');
			const answer = item.querySelector('.faq-answer');
			const inner = answer.querySelector('div');
			const icon = item.querySelector('.faq-icon-wrapper');

			trigger.addEventListener('click', () => {
				const isOpen = answer.classList.contains('grid-rows-[1fr]');
				
				// Close all other FAQs to keep accordion look premium
				faqItems.forEach(otherItem => {
					const otherAnswer = otherItem.querySelector('.faq-answer');
					const otherInner = otherAnswer.querySelector('div');
					const otherIcon = otherItem.querySelector('.faq-icon-wrapper');
					
					otherAnswer.classList.remove('grid-rows-[1fr]');
					otherAnswer.classList.add('grid-rows-[0fr]');
					otherInner.classList.remove('opacity-100');
					otherInner.classList.add('opacity-0');
					otherIcon.textContent = '+';
					otherIcon.classList.remove('bg-secondary', 'text-white', 'rotate-[135deg]');
					otherIcon.classList.add('bg-blue-50', 'text-secondary');
				});

				if (!isOpen) {
					answer.classList.remove('grid-rows-[0fr]');
					answer.classList.add('grid-rows-[1fr]');
					inner.classList.remove('opacity-0');
					inner.classList.add('opacity-100');
					icon.textContent = '×';
					icon.classList.remove('bg-blue-50', 'text-secondary');
					icon.classList.add('bg-secondary', 'text-white', 'rotate-[135deg]');
				}
			});
		});
	</script>
