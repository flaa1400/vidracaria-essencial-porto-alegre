---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE_CONFIG } from '../data/config';
import { Image } from 'astro:assets';

import ServiceIcon from '../components/ServiceIcon.astro';

// Import local images for Astro automatic optimization (WebP compilation & compression)
import vidroPremium from '../assets/vidro_premium.png';
import sacadaMedicao from '../assets/sacada_medicao.png';
import sacadaEstrutura from '../assets/sacada_estrutura.png';
import sacadaVidros from '../assets/sacada_vidros.png';
import sacadaVedacao from '../assets/sacada_vedacao.png';
import sacadaFinalizada from '../assets/sacada_finalizada.png';

const services = (await getCollection('servicos')).slice(0, 6);
---

<Layout title="Vidraçaria em Porto Alegre | Projetos sob Medida">
	<!-- Hero Section -->
	<section class="py-24 md:py-32 bg-white overflow-hidden">
		<div class="container mx-auto px-6 md:px-12">
			<div class="max-w-4xl">
				<span class="inline-block bg-primary text-secondary font-black px-4 py-1 uppercase tracking-[0.2em] text-[10px] mb-8">
					{SITE_CONFIG.tagline}
				</span>
				<h1 class="text-5xl md:text-7xl font-black leading-[1.1] mb-10 tracking-tighter text-gray-900 uppercase">
					Sua <span class="text-secondary underline decoration-primary decoration-[12px] underline-offset-[12px]">Vidraçaria em Porto Alegre</span> com acabamento de elite.
				</h1>
				<p class="text-lg md:text-xl text-gray-600 max-w-2xl leading-relaxed mb-12">
					A {SITE_CONFIG.name} é a melhor opção de vidraçaria em Porto Alegre para quem busca box de banheiro, espelhos e fechamento de sacadas premium. Se você está buscando uma <strong>vidraçaria mais próxima</strong>, conte com nossos <strong>Serviços de Vidraçaria em Porto Alegre‑RS Perto de Mim</strong> com precisão técnica milimétrica.
				</p>
				<div class="flex flex-col sm:flex-row gap-6">
					<a href={`https://wa.me/${SITE_CONFIG.contact.whatsapp}?text=${encodeURIComponent(SITE_CONFIG.contact.message)}`} class="bg-secondary text-white font-black px-12 py-7 text-center hover:bg-accent hover:scale-105 active:scale-95 transition-all shadow-2xl shadow-secondary/30 uppercase tracking-widest text-xs">
						Orçamento no WhatsApp
					</a>
					<a href="/servicos" class="bg-gray-100 text-gray-900 font-black px-12 py-7 text-center hover:bg-gray-200 hover:scale-105 active:scale-95 transition-all uppercase tracking-widest text-xs">
						Nossos Serviços
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Diferenciais -->
	<section class="py-24 md:py-32 bg-gray-50">
		<div class="container mx-auto px-6 md:px-12">
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
				<div class="p-12 bg-white border-b-8 border-primary shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all group">
					<div class="text-5xl mb-8 group-hover:scale-110 transition-transform inline-block">⚡</div>
					<h3 class="text-xl font-black mb-4 uppercase tracking-tight text-gray-900">Instalação Ágil</h3>
					<p class="text-gray-600 text-sm leading-relaxed">Sua obra não para. Garantimos prazos curtos e cumprimento rigoroso de cronograma em toda a região.</p>
				</div>
				<div class="p-12 bg-white border-b-8 border-secondary shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all group">
					<div class="text-5xl mb-8 group-hover:scale-110 transition-transform inline-block">💎</div>
					<h3 class="text-xl font-black mb-4 uppercase tracking-tight text-gray-900">Vidros Certificados</h3>
					<p class="text-gray-600 text-sm leading-relaxed">Materiais que seguem rigorosamente as normas ABNT, garantindo durabilidade e segurança total.</p>
				</div>
				<div class="p-12 bg-white border-b-8 border-accent shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all group">
					<div class="text-5xl mb-8 group-hover:scale-110 transition-transform inline-block">🛡️</div>
					<h3 class="text-xl font-black mb-4 uppercase tracking-tight text-gray-900">Garantia Real</h3>
					<p class="text-gray-600 text-sm leading-relaxed">Suporte pós-venda especializado e garantia assistida em todos os nossos serviços e ferragens.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Sobre Nós (Resumo) -->
	<section class="py-24 md:py-32 bg-white">
		<div class="container mx-auto px-6 md:px-12">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-center">
				<div class="bg-accent p-12 md:p-20 text-white shadow-2xl relative overflow-hidden">
					<div class="absolute top-0 right-0 w-32 h-32 bg-primary translate-x-16 -translate-y-16 rotate-45 opacity-50"></div>
					<h2 class="text-3xl md:text-5xl font-black mb-8 leading-tight tracking-tighter uppercase text-primary">Excelência em Vidros em {SITE_CONFIG.address.city}.</h2>
					<p class="text-gray-200 mb-12 text-lg leading-relaxed font-light">Unimos a leveza do vidro com a robustez de um serviço técnico impecável. Cada projeto é tratado como uma obra de arte única.</p>
					<a href="/sobre" class="inline-block bg-primary text-secondary font-black px-12 py-7 uppercase tracking-widest text-xs hover:scale-105 active:scale-95 transition-all shadow-xl shadow-primary/20">
						Nossa História
					</a>
				</div>
				<div class="grayscale hover:grayscale-0 transition-all duration-1000 shadow-2xl overflow-hidden group">
					<Image 
						src={vidroPremium} 
						alt="Instalação de Vidro Premium" 
						class="group-hover:scale-110 transition-transform duration-[2000ms] w-full h-full object-cover" 
						width={800} 
						height={600}
						format="webp"
						quality={80}
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Nossos Serviços -->
	<section class="py-24 md:py-32 bg-gray-50">
		<div class="container mx-auto px-6 md:px-12">
			<div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
				<div class="max-w-2xl">
					<h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tighter uppercase">Serviços de Elite</h2>
					<p class="text-lg text-gray-600 leading-relaxed font-medium">Como uma vidraçaria em Porto Alegre focada em qualidade, oferecemos soluções residenciais e comerciais com o mais alto padrão de acabamento.</p>
				</div>
				<a href="/servicos" class="text-secondary font-black border-b-4 border-primary pb-2 uppercase tracking-widest text-xs hover:text-accent transition-colors hover:scale-105 inline-block">
					Ver Tudo
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
				{services.map(service => (
					<a href={`/servicos/${service.slug}`} class="group bg-white p-12 shadow-sm hover:shadow-2xl transition-all border-l-[12px] border-gray-100 hover:border-primary flex flex-col justify-between">
						<div>
							<ServiceIcon slug={service.slug} />
							<h3 class="text-2xl font-black mb-6 uppercase group-hover:text-secondary transition-colors tracking-tight leading-none">{service.data.title}</h3>
							<p class="text-gray-600 text-sm leading-relaxed mb-8 line-clamp-3 font-medium">{service.data.description}</p>
						</div>
						<span class="text-secondary font-black text-[10px] uppercase tracking-[0.2em] group-hover:translate-x-4 inline-block transition-transform">Ver Detalhes &rarr;</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Depoimentos -->
	<section class="py-24 md:py-32 bg-white">
		<div class="container mx-auto px-6 md:px-12">
			<div class="text-center mb-20">
				<span class="inline-block bg-primary text-secondary font-black px-4 py-1 uppercase tracking-[0.2em] text-[10px] mb-8">
					Depoimentos de Clientes
				</span>
				<h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-gray-900">
					Quem Escolhe a Excelência
				</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
				{[1, 2, 3].map((_, i) => (
					<div class="p-12 bg-gray-50 relative group hover:bg-secondary transition-colors duration-500">
						<div class="text-7xl text-primary opacity-20 absolute top-4 left-4 font-serif">"</div>
						<p class="text-gray-600 text-lg mb-10 relative z-10 group-hover:text-white transition-colors italic leading-relaxed">
							{i === 0 && "O box do meu banheiro ficou perfeito. A instalação foi rápida e a equipe extremamente profissional."}
							{i === 1 && "Fizemos o fechamento da sacada e os espelhos. Acabamento impecável, superou expectativas."}
							{i === 2 && "Preço justo e pontualidade britânica. Melhor vidraçaria que já contratei na região."}
						</p>
						<div class="flex items-center gap-4 relative z-10">
							<div>
								<p class="font-black text-gray-900 group-hover:text-white transition-colors uppercase text-sm">
									{i === 0 && "Ricardo Mendes"}
									{i === 1 && "Carla Souza"}
									{i === 2 && "André Lima"}
								</p>
								<p class="text-[10px] text-gray-500 group-hover:text-primary transition-colors font-bold uppercase tracking-widest">
									{i === 0 && "Bairro Moinhos de Vento"}
									{i === 1 && "Bairro Menino Deus"}
									{i === 2 && "Bairro Petrópolis"}
								</p>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Serviços Realizados -->
	<section class="py-24 md:py-32 bg-secondary text-white relative overflow-hidden border-t border-blue-900">
		<div class="container mx-auto px-6 md:px-12 relative z-10">
			<div class="text-center mb-20">
				<span class="inline-block bg-primary text-secondary font-black px-4 py-1 uppercase tracking-[0.2em] text-[10px] mb-8">
					Portfólio de Obras
				</span>
				<h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none mb-6 text-white">
					Serviços de Envidraçamento de Sacadas realizados em Porto Alegre-RS
				</h2>
				<p class="text-lg text-blue-100 max-w-2xl mx-auto font-light">
					Confira alguns dos nossos serviços de envidraçamento de sacadas em Porto Alegre-RS.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Card 1 (Grande) -->
				<div class="relative overflow-hidden group shadow-2xl rounded-xl md:col-span-2 aspect-[16/10]">
					<Image 
						src={sacadaMedicao} 
						alt="Medição a laser e planejamento estrutural de sacada" 
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						width={800}
						height={500}
						format="webp"
						quality={80}
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex items-end p-6 md:p-8">
						<p class="text-white font-bold text-lg md:text-xl tracking-tight">Medição a laser e planejamento estrutural</p>
					</div>
				</div>

				<!-- Card 2 -->
				<div class="relative overflow-hidden group shadow-2xl rounded-xl md:col-span-1 aspect-[16/10] md:aspect-auto">
					<Image 
						src={sacadaEstrutura} 
						alt="Instalação dos trilhos de alumínio" 
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						width={800}
						height={500}
						format="webp"
						quality={80}
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex items-end p-6">
						<p class="text-white font-bold text-lg tracking-tight">Instalação dos trilhos de alumínio</p>
					</div>
				</div>

				<!-- Card 3 -->
				<div class="relative overflow-hidden group shadow-2xl rounded-xl aspect-[16/10]">
					<Image 
						src={sacadaVidros} 
						alt="Fixação de vidros temperados com ventosas" 
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						width={800}
						height={500}
						format="webp"
						quality={80}
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex items-end p-6">
						<p class="text-white font-bold text-lg tracking-tight">Fixação de vidros temperados com ventosas</p>
					</div>
				</div>

				<!-- Card 4 -->
				<div class="relative overflow-hidden group shadow-2xl rounded-xl aspect-[16/10]">
					<Image 
						src={sacadaVedacao} 
						alt="Vedação de alta precisão com silicone premium" 
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						width={800}
						height={500}
						format="webp"
						quality={80}
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex items-end p-6">
						<p class="text-white font-bold text-lg tracking-tight">Vedação de alta precisão com silicone premium</p>
					</div>
				</div>

				<!-- Card 5 -->
				<div class="relative overflow-hidden group shadow-2xl rounded-xl aspect-[16/10]">
					<Image 
						src={sacadaFinalizada} 
						alt="Acabamento final e fechamento completo da sacada" 
						class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
						width={800}
						height={500}
						format="webp"
						quality={80}
						loading="lazy"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent flex items-end p-6">
						<p class="text-white font-bold text-lg tracking-tight">Acabamento final e fechamento completo da sacada</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Final -->
	<section class="py-24 md:py-32 bg-secondary text-white relative overflow-hidden">
		<div class="absolute inset-0 opacity-10 pointer-events-none">
			<div class="absolute -top-1/2 -left-1/4 w-full h-full bg-primary rotate-12 rounded-[100px]"></div>
		</div>
		<div class="container mx-auto px-6 md:px-12 text-center relative z-10">
			<h2 class="text-4xl md:text-6xl font-black mb-10 tracking-tighter uppercase leading-none text-primary">Transforme sua casa <br/> com vidros de alto padrão.</h2>
			<p class="text-lg md:text-xl text-blue-100 max-w-2xl mx-auto mb-16 font-light">Se você busca o melhor telefone de vidraçaria para orçamentos precisos, fale agora com nossa vidraçaria em Porto Alegre e receba atendimento imediato.</p>
			<div class="flex flex-col md:flex-row justify-center gap-8">
				<a href={`https://wa.me/${SITE_CONFIG.contact.whatsapp}?text=${encodeURIComponent(SITE_CONFIG.contact.message)}`} class="bg-primary text-secondary font-black px-16 py-8 uppercase tracking-[0.2em] text-sm hover:scale-105 active:scale-95 transition-all shadow-2xl shadow-primary/40">
					Falar no WhatsApp
				</a>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="py-24 md:py-32 bg-gray-50 border-t border-gray-100">
		<div class="container mx-auto px-6 md:px-12">
			<div class="max-w-4xl mx-auto">
				<div class="text-center mb-20">
					<span class="inline-block bg-primary text-secondary font-black px-4 py-1 uppercase tracking-[0.2em] text-[10px] mb-8">
						Dúvidas Comuns
					</span>
					<h2 class="text-3xl md:text-5xl font-black tracking-tighter uppercase text-gray-900 leading-tight">
						Perguntas Frequentes Sobre Vidraçaria em Porto Alegre-RS
					</h2>
				</div>

				<div class="space-y-6">
					<!-- FAQ Item 1 -->
					<div class="faq-item bg-white border border-gray-100 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all cursor-pointer">
						<div class="faq-trigger flex justify-between items-center gap-4">
							<h3 class="text-base md:text-lg font-bold text-gray-900 tracking-tight leading-snug">
								Qual é o preço de uma vidraçaria em Porto Alegre-RS perto de mim?
							</h3>
							<span class="faq-icon-wrapper flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-secondary flex items-center justify-center font-bold text-lg transition-all duration-300">
								+
							</span>
						</div>
						<div class="faq-answer grid grid-rows-[0fr] transition-all duration-300 overflow-hidden">
							<div class="overflow-hidden text-gray-600 leading-loose text-sm md:text-base opacity-0 transition-opacity duration-300">
								<p class="mt-4 pt-4 border-t border-gray-50">
									O valor dos serviços de uma <strong>Vidraçaria em Porto Alegre-RS perto de mim</strong> varia de acordo com as especificidades do projeto, como o tipo de vidro (temperado, laminado ou acústico), espessura (8mm ou 10mm) e as ferragens utilizadas. Box de banheiro e espelhos lapidados possuem valores tabelados mais acessíveis, enquanto projetos sob medida como fechamento de sacadas e portas pivotantes dependem de visitas técnicas. Para obter o preço exato de uma <strong>Vidraçaria em Porto Alegre-RS perto de mim</strong>, entre em contato pelo WhatsApp e solicite uma estimativa detalhada sem compromisso.
								</p>
							</div>
						</div>
					</div>

					<!-- FAQ Item 2 -->
					<div class="faq-item bg-white border border-gray-100 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all cursor-pointer">
						<div class="faq-trigger flex justify-between items-center gap-4">
							<h3 class="text-base md:text-lg font-bold text-gray-900 tracking-tight leading-snug">
								Vocês fazem instalação em residências e comércios em Porto Alegre-RS?
							</h3>
							<span class="faq-icon-wrapper flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-secondary flex items-center justify-center font-bold text-lg transition-all duration-300">
								+
							</span>
						</div>
						<div class="faq-answer grid grid-rows-[0fr] transition-all duration-300 overflow-hidden">
							<div class="overflow-hidden text-gray-600 leading-loose text-sm md:text-base opacity-0 transition-opacity duration-300">
								<p class="mt-4 pt-4 border-t border-gray-50">
									Sim! A nossa <strong>Vidraçaria em Porto Alegre-RS</strong> conta com técnicos especializados tanto para instalações residenciais quanto para grandes projetos comerciais. Atendemos lojas, escritórios corporativos, condomínios e residências, instalando divisórias de vidro, fachadas em pele de vidro, portas de segurança e espelhos sob medida com rapidez, acabamento profissional e dentro das normas da ABNT.
								</p>
							</div>
						</div>
					</div>

					<!-- FAQ Item 3 -->
					<div class="faq-item bg-white border border-gray-100 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all cursor-pointer">
						<div class="faq-trigger flex justify-between items-center gap-4">
							<h3 class="text-base md:text-lg font-bold text-gray-900 tracking-tight leading-snug">
								Uma vidraçaria em Porto Alegre-RS próxima de mim fica mais barata?
							</h3>
							<span class="faq-icon-wrapper flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-secondary flex items-center justify-center font-bold text-lg transition-all duration-300">
								+
							</span>
						</div>
						<div class="faq-answer grid grid-rows-[0fr] transition-all duration-300 overflow-hidden">
							<div class="overflow-hidden text-gray-600 leading-loose text-sm md:text-base opacity-0 transition-opacity duration-300">
								<p class="mt-4 pt-4 border-t border-gray-50">
									Contratar uma <strong>Vidraçaria em Porto Alegre-RS próxima de mim</strong> costuma ser mais vantajoso e econômico. A proximidade geográfica reduz significativamente os custos de frete e deslocamento das equipes técnicas, além de permitir um atendimento pós-venda muito mais ágil. Além disso, uma <strong>Vidraçaria em Porto Alegre-RS próxima de mim</strong> consegue realizar a medição técnica e a entrega dos vidros temperados em prazos muito mais curtos, trazendo mais economia e praticidade para sua obra.
								</p>
							</div>
						</div>
					</div>

					<!-- FAQ Item 4 -->
					<div class="faq-item bg-white border border-gray-100 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all cursor-pointer">
						<div class="faq-trigger flex justify-between items-center gap-4">
							<h3 class="text-base md:text-lg font-bold text-gray-900 tracking-tight leading-snug">
								O serviço de medição é gratuito em Porto Alegre-RS?
							</h3>
							<span class="faq-icon-wrapper flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-secondary flex items-center justify-center font-bold text-lg transition-all duration-300">
								+
							</span>
						</div>
						<div class="faq-answer grid grid-rows-[0fr] transition-all duration-300 overflow-hidden">
							<div class="overflow-hidden text-gray-600 leading-loose text-sm md:text-base opacity-0 transition-opacity duration-300">
								<p class="mt-4 pt-4 border-t border-gray-50">
									Sim, na nossa <strong>Vidraçaria em Porto Alegre-RS</strong>, nós oferecemos a visita técnica e a medição com trena a laser de forma totalmente gratuita após um orçamento preliminar aprovado via WhatsApp. Isso garante precisão técnica absoluta para a fabricação dos vidros temperados sem nenhum custo extra de surpresa para você.
								</p>
							</div>
						</div>
					</div>

					<!-- FAQ Item 5 -->
					<div class="faq-item bg-white border border-gray-100 rounded-xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all cursor-pointer">
						<div class="faq-trigger flex justify-between items-center gap-4">
							<h3 class="text-base md:text-lg font-bold text-gray-900 tracking-tight leading-snug">
								Como contratar uma boa vidraçaria em Porto Alegre-RS?
							</h3>
							<span class="faq-icon-wrapper flex-shrink-0 w-8 h-8 rounded-full bg-blue-50 text-secondary flex items-center justify-center font-bold text-lg transition-all duration-300">
								+
							</span>
						</div>
						<div class="faq-answer grid grid-rows-[0fr] transition-all duration-300 overflow-hidden">
							<div class="overflow-hidden text-gray-600 leading-loose text-sm md:text-base opacity-0 transition-opacity duration-300">
								<p class="mt-4 pt-4 border-t border-gray-50">
									Para escolher uma excelente <strong>Vidraçaria em Porto Alegre-RS</strong>, é fundamental analisar três pontos cruciais: a reputação da empresa no mercado local, a conformidade de seus produtos com as normas técnicas de segurança da ABNT (especialmente a NBR 14698 para vidros temperados) e o portfólio de projetos já executados. Opte sempre por profissionais que ofereçam garantia assistida por escrito e atendimento transparente no suporte pós-venda.
